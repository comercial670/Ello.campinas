      "id": "97c85ff6-6f15-46ee-b351-d1f2604cbff4",
      "name": "10b_Merge_Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        2000
      ],
      "parameters": {
        "jsCode": "const prev = $(\"9_Dedupe_Limite_100dia\");\nconst out = [];\n$input.all().forEach((item,i) => {\n  try {\n    const d = JSON.parse(item.json.choices[0].message.content);\n    const p = prev.item(i).json;\n    out.push({ json: { ...p, assunto: d.assunto, corpo: d.corpo }});\n  } catch(e){}\n});\nreturn out;"
      }
    },
