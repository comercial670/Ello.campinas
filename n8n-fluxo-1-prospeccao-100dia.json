      "parameters": {
        "jsCode": "const cfg = $(\"0_CONFIG\").first().json.config;\nconst enviados = $input.all().length;\nconst pesquisados = $(\"2_Separar_Resultados\").all().length;\nconst qualificados = $(\"7_Parse_Qualificados\").all().length;\nconst txt = \"RELATORIO DIARIO PROSPECCAO ELLO\\nEmpresas pesquisadas: \" + pesquisados + \"\\nQualificadas: \" + qualificados + \"\\nEmails enviados hoje: \" + enviados + \"/100\";\nreturn [{ json: { texto: txt, config: cfg }}];"
